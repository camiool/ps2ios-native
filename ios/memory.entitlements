<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PS2_IOS_MORE_MEMORY=ON: a game with a large program, or at twice the resolution, can need more memory than iOS gives an app by
     default. The signing team must have the "Increased Memory Limit" capability. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
